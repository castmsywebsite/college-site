---
import Footer from "@/components/footer.astro";
import "@/styles/global.css";

interface Props {
  title?: string;
}

const { title = "Admin Portal" } = Astro.props;
const currentPath = Astro.url.pathname;
const user = Astro.locals.user;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/assets/images/logo.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | CAS TMSY Admin</title>

    <!-- PHASE 2.2: BFCache Restoration Defense for Protected Admin Pages -->
    <script is:inline>
      (function() {
        // 1. Conceal DOM and reload from server if page is thawed from BFCache
        window.addEventListener('pageshow', function(event) {
          var isBfCache = event.persisted || 
            (window.performance && window.performance.getEntriesByType && 
             window.performance.getEntriesByType('navigation')[0] && 
             window.performance.getEntriesByType('navigation')[0].type === 'back_forward');

          if (isBfCache) {
            // Immediately conceal the DOM to prevent visual exposure of sensitive admin content
            if (document.body) {
              document.body.style.display = 'none';
            }
            // Force authoritative server-side session validation via full reload
            window.location.reload();
          }
        });

        // 2. Handle pagehide: if being persisted into bfcache, conceal sensitive content
        window.addEventListener('pagehide', function(event) {
          if (event.persisted) {
            if (document.body) {
              document.body.style.display = 'none';
            }
          }
        });
      })();
    </script>
  </head>
  <body>
    <div class="min-h-screen bg-gray-50 font-inter flex flex-col">
      <!-- Admin Top Navigation Bar (SEC-HIGH-03: Visible Admin Navigation & Logout) -->
      <header class="bg-white border-b border-gray-200 sticky top-0 z-40">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="flex justify-between h-16 items-center">
            <div class="flex items-center space-x-8">
              <a href="/admin" class="flex items-center space-x-2 text-indigo-700 font-bold text-lg">
                <span class="text-2xl">🏛️</span>
                <span>CAS TMSY Admin</span>
              </a>
              <nav class="hidden md:flex space-x-3 text-sm font-medium">
                <a href="/admin" class={`px-2.5 py-1.5 rounded-md ${currentPath === "/admin" ? "bg-indigo-50 text-indigo-700 font-semibold" : "text-gray-600 hover:text-gray-900 hover:bg-gray-100"}`}>Dashboard</a>
                <a href="/admin/administration" class={`px-2.5 py-1.5 rounded-md ${currentPath.startsWith("/admin/administration") ? "bg-indigo-50 text-indigo-700 font-semibold" : "text-gray-600 hover:text-gray-900 hover:bg-gray-100"}`}>Staff</a>
                <a href="/admin/academics" class={`px-2.5 py-1.5 rounded-md ${currentPath.startsWith("/admin/academics") ? "bg-indigo-50 text-indigo-700 font-semibold" : "text-gray-600 hover:text-gray-900 hover:bg-gray-100"}`}>Academics</a>
                <a href="/admin/placements" class={`px-2.5 py-1.5 rounded-md ${currentPath.startsWith("/admin/placements") ? "bg-indigo-50 text-indigo-700 font-semibold" : "text-gray-600 hover:text-gray-900 hover:bg-gray-100"}`}>Placements</a>
                <a href="/admin/events" class={`px-2.5 py-1.5 rounded-md ${currentPath.startsWith("/admin/events") ? "bg-indigo-50 text-indigo-700 font-semibold" : "text-gray-600 hover:text-gray-900 hover:bg-gray-100"}`}>Events</a>
                <a href="/admin/announcements" class={`px-2.5 py-1.5 rounded-md ${currentPath.startsWith("/admin/announcements") ? "bg-indigo-50 text-indigo-700 font-semibold" : "text-gray-600 hover:text-gray-900 hover:bg-gray-100"}`}>Announcements</a>
                <a href="/admin/gallery" class={`px-2.5 py-1.5 rounded-md ${currentPath.startsWith("/admin/gallery") ? "bg-indigo-50 text-indigo-700 font-semibold" : "text-gray-600 hover:text-gray-900 hover:bg-gray-100"}`}>Gallery</a>
              </nav>
            </div>
            <div class="flex items-center space-x-4">
              {user && (
                <span class="text-xs text-gray-500 hidden sm:inline-block">
                  Signed in as <strong class="text-gray-700">{user.username}</strong>
                </span>
              )}
              <form method="POST" action="/api/admin/auth/logout" class="inline">
                <button
                  type="submit"
                  class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-sm font-medium text-red-600 bg-red-50 hover:bg-red-100 border border-red-200 transition-colors cursor-pointer"
                  title="Sign out of Admin Dashboard"
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
                  </svg>
                  <span>Logout</span>
                </button>
              </form>
            </div>
          </div>
        </div>
      </header>

      <main class="flex-1"><slot /></main>
      <Footer />
    </div>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
