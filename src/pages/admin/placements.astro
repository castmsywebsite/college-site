---
import AdminLayout from "@/layouts/AdminLayout.astro";

if (!Astro.locals.session) {
  return Astro.redirect("/admin/admin-login-user-access");
}
---

<AdminLayout title="Manage Student Placements">
  <div class="space-y-6 max-w-6xl mx-auto px-4 py-10">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
      <div>
        <h1 class="text-3xl font-bold text-gray-900">
          Manage Student Placements
        </h1>
        <p class="text-gray-500 mt-1">
          Add, edit, and organize student job placement records and photographs.
        </p>
      </div>
      <button
        id="addPlacementBtn"
        class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2.5 rounded-lg font-medium transition-colors flex items-center gap-2 shadow-sm cursor-pointer"
      >
        <span class="text-xl leading-none">+</span> Add Placement
      </button>
    </div>

    <!-- Error / Success Alerts -->
    <div id="alertContainer" class="hidden rounded-lg p-4 text-sm font-medium"></div>

    <!-- Loading State -->
    <div id="loadingState" class="py-12 flex justify-center items-center">
      <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600"></div>
      <span class="ml-3 text-gray-600">Loading placement records...</span>
    </div>

    <!-- Empty State -->
    <div id="emptyState" class="hidden text-center py-16 bg-white rounded-xl border border-dashed border-gray-300 p-8">
      <span class="text-4xl">🎓</span>
      <h3 class="mt-2 text-lg font-semibold text-gray-900">No placements found</h3>
      <p class="mt-1 text-sm text-gray-500">Get started by adding your first placed student record.</p>
      <button
        id="emptyAddBtn"
        class="mt-4 inline-flex items-center gap-2 px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition"
      >
        + Add Placement
      </button>
    </div>

    <!-- Placements Grid -->
    <div id="placementsGrid" class="hidden grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6"></div>

    <!-- Placement Modal (Add / Edit) -->
    <div
      id="placementModal"
      class="fixed inset-0 bg-black/50 hidden z-50 flex items-center justify-center p-4 backdrop-blur-sm overflow-y-auto"
    >
      <div class="bg-white rounded-xl shadow-xl max-w-lg w-full p-6 my-8 transform transition-all">
        <div class="flex justify-between items-center mb-6">
          <h2 class="text-xl font-bold text-gray-900" id="modalTitle">
            Add Student Placement
          </h2>
          <button
            id="closeModalBtn"
            class="text-gray-400 hover:text-gray-600 transition-colors p-1"
            aria-label="Close modal"
          >
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <form id="placementForm" class="space-y-4">
          <input type="hidden" id="placementId" name="id" />

          <!-- Student Name -->
          <div>
            <label for="studentName" class="block text-sm font-medium text-gray-700 mb-1">
              Student Name <span class="text-red-500">*</span>
            </label>
            <input
              type="text"
              id="studentName"
              name="studentName"
              required
              class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent text-sm"
              placeholder="e.g. Rahul V P"
            />
          </div>

          <!-- Company Name -->
          <div>
            <label for="companyName" class="block text-sm font-medium text-gray-700 mb-1">
              Placed Company <span class="text-red-500">*</span>
            </label>
            <input
              type="text"
              id="companyName"
              name="companyName"
              required
              class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent text-sm"
              placeholder="e.g. Tata Consultancy Services, Wipro"
            />
          </div>

          <!-- Position / Job Role -->
          <div>
            <label for="position" class="block text-sm font-medium text-gray-700 mb-1">
              Designation / Role <span class="text-gray-400 font-normal">(Optional)</span>
            </label>
            <input
              type="text"
              id="position"
              name="position"
              class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent text-sm"
              placeholder="e.g. Software Support Executive"
            />
          </div>

          <!-- Graduated Year -->
          <div>
            <label for="graduatedYear" class="block text-sm font-medium text-gray-700 mb-1">
              Graduated Year <span class="text-red-500">*</span>
            </label>
            <input
              type="text"
              id="graduatedYear"
              name="graduatedYear"
              required
              class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent text-sm"
              placeholder="e.g. 2023 or 2021 - 24"
            />
          </div>

          <!-- Photograph Upload -->
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">
              Student Photograph
            </label>
            <input type="hidden" id="imageUrl" name="imageUrl" />

            <div class="flex items-start gap-3 p-3 rounded-lg border border-gray-200 bg-gray-50">
              <div class="relative h-20 w-20 shrink-0 overflow-hidden rounded-lg border bg-white flex items-center justify-center">
                <img
                  id="imagePreview"
                  src=""
                  alt="Student Preview"
                  class="h-full w-full object-contain hidden"
                />
                <span id="imagePlaceholder" class="text-3xl text-gray-300">👤</span>
              </div>

              <div class="flex-1 space-y-2 min-w-0">
                <div class="flex flex-wrap items-center gap-2">
                  <input
                    type="file"
                    id="photoFileInput"
                    accept="image/jpeg,image/png,image/webp,image/jpg"
                    class="hidden"
                  />
                  <button
                    type="button"
                    id="selectPhotoBtn"
                    class="rounded-md border border-gray-300 bg-white px-3 py-1.5 text-xs font-medium text-gray-700 hover:bg-gray-100 transition"
                  >
                    Select Photo
                  </button>
                  <button
                    type="button"
                    id="removePhotoBtn"
                    class="rounded-md border border-red-200 bg-red-50 px-2.5 py-1.5 text-xs font-medium text-red-600 hover:bg-red-100 transition hidden"
                  >
                    Remove
                  </button>
                </div>
                <div id="photoStatusText" class="text-xs text-gray-500">
                  JPG, JPEG, PNG, or WebP (max 5MB)
                </div>
              </div>
            </div>
          </div>

          <div id="formError" class="text-xs text-red-600 font-medium hidden"></div>

          <!-- Buttons -->
          <div class="flex justify-end gap-3 pt-4 border-t border-gray-100">
            <button
              type="button"
              id="cancelBtn"
              class="px-4 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition font-medium text-sm"
            >
              Cancel
            </button>
            <button
              type="submit"
              id="submitBtn"
              class="px-5 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition font-medium text-sm flex items-center gap-2"
            >
              <span>Save Placement</span>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  let placements: any[] = [];
  let isEditing = false;
  let isUploading = false;

  const loadingState = document.getElementById("loadingState");
  const emptyState = document.getElementById("emptyState");
  const placementsGrid = document.getElementById("placementsGrid");
  const modal = document.getElementById("placementModal");
  const modalTitle = document.getElementById("modalTitle");
  const form = document.getElementById("placementForm") as HTMLFormElement;
  const formError = document.getElementById("formError");
  const alertContainer = document.getElementById("alertContainer");
  const submitBtn = document.getElementById("submitBtn") as HTMLButtonElement;

  const photoFileInput = document.getElementById("photoFileInput") as HTMLInputElement;
  const selectPhotoBtn = document.getElementById("selectPhotoBtn");
  const removePhotoBtn = document.getElementById("removePhotoBtn");
  const imagePreview = document.getElementById("imagePreview") as HTMLImageElement;
  const imagePlaceholder = document.getElementById("imagePlaceholder");
  const imageUrlInput = document.getElementById("imageUrl") as HTMLInputElement;
  const photoStatusText = document.getElementById("photoStatusText");

  function showAlert(msg: string, type: "success" | "error") {
    if (!alertContainer) return;
    alertContainer.textContent = msg;
    alertContainer.className = `rounded-lg p-4 text-sm font-medium ${
      type === "success"
        ? "bg-green-50 text-green-800 border border-green-200"
        : "bg-red-50 text-red-800 border border-red-200"
    }`;
    alertContainer.classList.remove("hidden");
    setTimeout(() => {
      alertContainer.classList.add("hidden");
    }, 5000);
  }

  async function loadPlacements() {
    try {
      if (loadingState) loadingState.classList.remove("hidden");
      if (emptyState) emptyState.classList.add("hidden");
      if (placementsGrid) placementsGrid.classList.add("hidden");

      const res = await fetch("/api/placements", { cache: "no-store" });
      if (!res.ok) throw new Error("Failed to load placements");
      placements = await res.json();
      renderPlacements();
    } catch (err: any) {
      console.error(err);
      showAlert(err.message || "Failed to load placement records", "error");
    } finally {
      if (loadingState) loadingState.classList.add("hidden");
    }
  }

  function getInitials(name: string): string {
    if (!name) return "🎓";
    const parts = name.trim().split(/\s+/);
    if (parts.length === 1) return parts[0].slice(0, 2).toUpperCase();
    return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
  }

  function renderPlacements() {
    if (!placementsGrid || !emptyState) return;

    if (!placements || placements.length === 0) {
      emptyState.classList.remove("hidden");
      placementsGrid.classList.add("hidden");
      return;
    }

    emptyState.classList.add("hidden");
    placementsGrid.classList.remove("hidden");
    placementsGrid.innerHTML = "";

    placements.forEach((p) => {
      const card = document.createElement("div");
      card.className =
        "bg-white border border-slate-200/90 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-all duration-300 flex flex-col group";

      card.innerHTML = `
        <div class="relative w-full aspect-[4/5] sm:aspect-[3/4] max-h-64 bg-slate-100 flex items-center justify-center p-3 overflow-hidden border-b border-slate-100">
          ${
            p.imageUrl
              ? `
                <img src="${p.imageUrl}" alt="" aria-hidden="true" class="absolute inset-0 w-full h-full object-cover blur-2xl scale-125 opacity-40 brightness-95 select-none pointer-events-none" />
                <div class="absolute inset-0 bg-white/30 backdrop-blur-sm pointer-events-none"></div>
                <img src="${p.imageUrl}" alt="${p.studentName}" class="relative z-10 max-h-full max-w-full w-auto h-auto object-contain rounded-xl shadow-md border border-white/80 transition-transform duration-300 group-hover:scale-[1.03]" />
              `
              : `
                <div class="absolute inset-0 bg-gradient-to-br from-blue-50 via-indigo-50/50 to-slate-100"></div>
                <div class="relative z-10 flex flex-col items-center justify-center gap-1.5">
                  <div class="w-16 h-16 rounded-full bg-gradient-to-br from-blue-600 to-indigo-700 text-white font-bold text-xl shadow-md ring-4 ring-white flex items-center justify-center tracking-wider">
                    ${getInitials(p.studentName)}
                  </div>
                  <span class="text-[10px] font-semibold text-slate-500 uppercase tracking-wider">CAS TMSY Alumni</span>
                </div>
              `
          }
        </div>
        <div class="p-4 sm:p-5 flex flex-col flex-grow justify-between bg-white">
          <div>
            <div class="flex items-center justify-between gap-2 mb-2">
              <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold bg-blue-50 text-blue-700 border border-blue-200/60">
                Placed
              </span>
              <span class="text-xs font-semibold text-slate-600 bg-slate-100 px-2 py-0.5 rounded">
                ${p.graduatedYear}
              </span>
            </div>
            <h3 class="font-bold text-slate-900 text-base leading-snug group-hover:text-blue-600 transition-colors">${p.studentName}</h3>
            ${p.position ? `<p class="text-xs text-slate-500 mt-0.5 line-clamp-1">${p.position}</p>` : ""}
            <p class="text-sm font-semibold text-blue-700 mt-1 line-clamp-1 flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-blue-600 inline-block shrink-0"></span>
              ${p.companyName}
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-end">
            <div class="flex items-center gap-2">
              <button
                class="edit-btn px-3 py-1 text-xs font-medium text-blue-600 bg-blue-50 hover:bg-blue-100 rounded-md transition"
                data-id="${p.id}"
              >
                Edit
              </button>
              <button
                class="delete-btn px-3 py-1 text-xs font-medium text-red-600 bg-red-50 hover:bg-red-100 rounded-md transition"
                data-id="${p.id}"
              >
                Delete
              </button>
            </div>
          </div>
        </div>
      `;

      card.querySelector(".edit-btn")?.addEventListener("click", () => openEditModal(p.id));
      card.querySelector(".delete-btn")?.addEventListener("click", () => deletePlacement(p.id));

      placementsGrid.appendChild(card);
    });
  }

  function openAddModal() {
    isEditing = false;
    form.reset();
    (document.getElementById("placementId") as HTMLInputElement).value = "";
    if (modalTitle) modalTitle.textContent = "Add Student Placement";
    if (formError) formError.classList.add("hidden");
    resetPhotoPreview();
    modal?.classList.remove("hidden");
  }

  function openEditModal(id: string) {
    const p = placements.find((item) => item.id === id);
    if (!p) return;

    isEditing = true;
    (document.getElementById("placementId") as HTMLInputElement).value = p.id;
    (document.getElementById("studentName") as HTMLInputElement).value = p.studentName;
    (document.getElementById("companyName") as HTMLInputElement).value = p.companyName;
    (document.getElementById("position") as HTMLInputElement).value = p.position || "";
    (document.getElementById("graduatedYear") as HTMLInputElement).value = p.graduatedYear;

    if (modalTitle) modalTitle.textContent = "Edit Student Placement";
    if (formError) formError.classList.add("hidden");

    if (p.imageUrl) {
      setPhotoPreview(p.imageUrl);
    } else {
      resetPhotoPreview();
    }

    modal?.classList.remove("hidden");
  }

  function closeModal() {
    modal?.classList.add("hidden");
  }

  function setPhotoPreview(url: string) {
    if (imageUrlInput) imageUrlInput.value = url;
    if (imagePreview) {
      imagePreview.src = url;
      imagePreview.classList.remove("hidden");
    }
    if (imagePlaceholder) imagePlaceholder.classList.add("hidden");
    if (removePhotoBtn) removePhotoBtn.classList.remove("hidden");
    if (photoStatusText) photoStatusText.textContent = "Photo uploaded successfully";
  }

  function resetPhotoPreview() {
    if (imageUrlInput) imageUrlInput.value = "";
    if (imagePreview) {
      imagePreview.src = "";
      imagePreview.classList.add("hidden");
    }
    if (imagePlaceholder) imagePlaceholder.classList.remove("hidden");
    if (removePhotoBtn) removePhotoBtn.classList.add("hidden");
    if (photoFileInput) photoFileInput.value = "";
    if (photoStatusText) photoStatusText.textContent = "JPG, JPEG, PNG, or WebP (max 5MB)";
  }

  // Upload handler for student photo
  photoFileInput?.addEventListener("change", async (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (!file) return;

    if (file.size > 5 * 1024 * 1024) {
      alert("File size exceeds 5MB limit.");
      photoFileInput.value = "";
      return;
    }

    try {
      isUploading = true;
      if (photoStatusText) photoStatusText.textContent = "Uploading photograph...";
      if (selectPhotoBtn) selectPhotoBtn.setAttribute("disabled", "true");

      const formData = new FormData();
      formData.append("file", file);

      const res = await fetch("/api/placements/upload", {
        method: "POST",
        body: formData,
      });

      const result = await res.json();
      if (!res.ok) throw new Error(result.error || "Upload failed");

      setPhotoPreview(result.url);
    } catch (err: any) {
      console.error(err);
      alert(err.message || "Failed to upload photo");
      resetPhotoPreview();
    } finally {
      isUploading = false;
      if (selectPhotoBtn) selectPhotoBtn.removeAttribute("disabled");
    }
  });

  selectPhotoBtn?.addEventListener("click", () => photoFileInput?.click());
  removePhotoBtn?.addEventListener("click", resetPhotoPreview);

  // Form submit handler
  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (isUploading) {
      alert("Please wait for the image upload to complete.");
      return;
    }

    const id = (document.getElementById("placementId") as HTMLInputElement).value;
    const studentName = (document.getElementById("studentName") as HTMLInputElement).value.trim();
    const companyName = (document.getElementById("companyName") as HTMLInputElement).value.trim();
    const position = (document.getElementById("position") as HTMLInputElement).value.trim();
    const graduatedYear = (document.getElementById("graduatedYear") as HTMLInputElement).value.trim();
    const imageUrl = imageUrlInput.value.trim();

    if (!studentName || !companyName || !graduatedYear) {
      if (formError) {
        formError.textContent = "Please fill in all required fields.";
        formError.classList.remove("hidden");
      }
      return;
    }

    try {
      submitBtn.disabled = true;
      submitBtn.textContent = "Saving...";

      const url = isEditing ? `/api/placements/${id}` : "/api/placements";
      const method = isEditing ? "PUT" : "POST";

      const res = await fetch(url, {
        method,
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          studentName,
          companyName,
          position,
          graduatedYear,
          imageUrl,
        }),
      });

      const result = await res.json();
      if (!res.ok) throw new Error(result.error || "Failed to save placement");

      closeModal();
      showAlert(isEditing ? "Placement updated successfully" : "Placement added successfully", "success");
      loadPlacements();
    } catch (err: any) {
      console.error(err);
      if (formError) {
        formError.textContent = err.message || "Failed to save placement";
        formError.classList.remove("hidden");
      }
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = "Save Placement";
    }
  });

  async function deletePlacement(id: string) {
    if (!confirm("Are you sure you want to delete this placement record?")) return;

    try {
      const res = await fetch(`/api/placements/${id}`, { method: "DELETE" });
      const result = await res.json();
      if (!res.ok) throw new Error(result.error || "Failed to delete placement");

      showAlert("Placement record deleted", "success");
      loadPlacements();
    } catch (err: any) {
      console.error(err);
      showAlert(err.message || "Failed to delete placement", "error");
    }
  }

  document.getElementById("addPlacementBtn")?.addEventListener("click", openAddModal);
  document.getElementById("emptyAddBtn")?.addEventListener("click", openAddModal);
  document.getElementById("closeModalBtn")?.addEventListener("click", closeModal);
  document.getElementById("cancelBtn")?.addEventListener("click", closeModal);

  // Load on start
  loadPlacements();
</script>
