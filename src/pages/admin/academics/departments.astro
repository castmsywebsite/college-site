---
import AdminLayout from "@/layouts/AdminLayout.astro";
if (!Astro.locals.session) {
  return Astro.redirect("/admin/admin-login-user-access");
}
---

<AdminLayout>
  <section class="mx-auto max-w-6xl px-4 py-10">
    <header class="mb-8">
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-2xl font-semibold tracking-tight">
            Manage Departments
          </h1>
          <p class="text-muted-foreground mt-1">
            Add, edit, and manage academic departments and faculty.
          </p>
        </div>
        <button
          id="add-department-btn"
          class="inline-flex items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground shadow transition-colors hover:bg-primary/90 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50"
        >
          Add Department
        </button>
      </div>
    </header>

    <div class="rounded-lg border bg-card">
      <div class="p-6">
        <div id="departments-list" class="space-y-4">
        </div>
      </div>
    </div>
  </section>

  <div id="department-modal" class="fixed inset-0 z-50 hidden bg-black/50">
    <div class="flex min-h-full items-center justify-center p-4">
      <div class="w-full max-w-2xl rounded-lg bg-white p-6 shadow-lg">
        <div class="mb-4 flex items-center justify-between">
          <h2 id="modal-title" class="text-lg font-semibold">Add Department</h2>
          <button id="close-modal" class="text-gray-400 hover:text-gray-600">
            <svg
              class="h-6 w-6"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>

        <form id="department-form" class="space-y-4">
          <div>
            <label for="name" class="block text-sm font-medium text-gray-700"
              >Department Name</label
            >
            <input
              type="text"
              id="name"
              name="name"
              required
              class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-primary focus:outline-none focus:ring-primary"
            />
          </div>

          <div>
            <label for="hod" class="block text-sm font-medium text-gray-700"
              >Head of Department</label
            >
            <input
              type="text"
              id="hod"
              name="hod"
              required
              class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-primary focus:outline-none focus:ring-primary"
            />
          </div>

          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div>
              <label
                for="faculty"
                class="block text-sm font-medium text-gray-700"
                >Number of Faculty</label
              >
              <input
                type="number"
                id="faculty"
                name="faculty"
                required
                min="1"
                class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-primary focus:outline-none focus:ring-primary"
              />
            </div>
            <div>
              <label for="labs" class="block text-sm font-medium text-gray-700"
                >Number of Labs</label
              >
              <input
                type="number"
                id="labs"
                name="labs"
                required
                min="0"
                class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-primary focus:outline-none focus:ring-primary"
              />
            </div>
          </div>

          <div>
            <label
              for="description"
              class="block text-sm font-medium text-gray-700">Description</label
            >
            <textarea
              id="description"
              name="description"
              rows="3"
              class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-primary focus:outline-none focus:ring-primary"
            ></textarea>
          </div>

          <div>
            <label
              for="specializations"
              class="block text-sm font-medium text-gray-700"
              >Specializations (one per line)</label
            >
            <textarea
              id="specializations"
              name="specializations"
              rows="4"
              placeholder="Enter specializations, one per line"
              class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-primary focus:outline-none focus:ring-primary"
            ></textarea>
          </div>

          <div class="flex justify-end space-x-3">
            <button
              type="button"
              id="cancel-btn"
              class="rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-primary"
            >
              Cancel
            </button>
            <button
              type="submit"
              class="rounded-md bg-primary px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-primary/90 focus:outline-none focus:ring-2 focus:ring-primary"
            >
              Save Department
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script type="module">
    let departments = [];
    let editingDepartment = null;

    async function loadDepartments() {
      try {
        const response = await fetch("/api/admin/academics/departments");
        if (!response.ok) {
          throw new Error(`HTTP error! status: ${response.status}`);
        }
        departments = await response.json();
        renderDepartments();
      } catch (error) {
        console.error("Error loading departments:", error);
        showNotification("Error loading departments", "error");
      }
    }

    // SEC-HIGH-02: Safe DOM construction preventing Stored XSS
    function renderDepartments() {
      const container = document.getElementById("departments-list");
      container.innerHTML = "";

      if (departments.length === 0) {
        const emptyP = document.createElement("p");
        emptyP.className = "text-center text-gray-500 py-8";
        emptyP.textContent = "No departments found. Add your first department!";
        container.appendChild(emptyP);
        return;
      }

      departments.forEach((department) => {
        const card = document.createElement("div");
        card.className = "rounded-lg border bg-white p-4";

        const flexWrapper = document.createElement("div");
        flexWrapper.className = "flex items-start justify-between";

        const contentDiv = document.createElement("div");
        contentDiv.className = "flex-1";

        const titleH3 = document.createElement("h3");
        titleH3.className = "text-lg font-semibold";
        titleH3.textContent = department.name || "";
        contentDiv.appendChild(titleH3);

        const statsGrid = document.createElement("div");
        statsGrid.className = "mt-2 grid grid-cols-2 gap-4 text-sm text-gray-600";

        const hodDiv = document.createElement("div");
        const hodLabel = document.createElement("span");
        hodLabel.className = "font-medium";
        hodLabel.textContent = "HOD: ";
        hodDiv.appendChild(hodLabel);
        hodDiv.appendChild(document.createTextNode(department.hod || ""));

        const facultyDiv = document.createElement("div");
        const facultyLabel = document.createElement("span");
        facultyLabel.className = "font-medium";
        facultyLabel.textContent = "Faculty: ";
        facultyDiv.appendChild(facultyLabel);
        facultyDiv.appendChild(document.createTextNode(String(department.faculty ?? 0)));

        const labsDiv = document.createElement("div");
        const labsLabel = document.createElement("span");
        labsLabel.className = "font-medium";
        labsLabel.textContent = "Labs: ";
        labsDiv.appendChild(labsLabel);
        labsDiv.appendChild(document.createTextNode(String(department.labs ?? 0)));

        const specsCountDiv = document.createElement("div");
        const specsLabel = document.createElement("span");
        specsLabel.className = "font-medium";
        specsLabel.textContent = "Specializations: ";
        specsCountDiv.appendChild(specsLabel);
        specsCountDiv.appendChild(document.createTextNode(String(department.specializations ? department.specializations.length : 0)));

        statsGrid.appendChild(hodDiv);
        statsGrid.appendChild(facultyDiv);
        statsGrid.appendChild(labsDiv);
        statsGrid.appendChild(specsCountDiv);
        contentDiv.appendChild(statsGrid);

        if (department.description) {
          const descP = document.createElement("p");
          descP.className = "mt-2 text-sm text-gray-600";
          descP.textContent = department.description;
          contentDiv.appendChild(descP);
        }

        if (department.specializations && department.specializations.length > 0) {
          const specsWrapper = document.createElement("div");
          specsWrapper.className = "mt-2";

          const specsHeader = document.createElement("span");
          specsHeader.className = "text-sm font-medium text-gray-700";
          specsHeader.textContent = "Specializations:";
          specsWrapper.appendChild(specsHeader);

          const specsTags = document.createElement("div");
          specsTags.className = "mt-1 flex flex-wrap gap-1";

          department.specializations.forEach((spec) => {
            const tag = document.createElement("span");
            tag.className = "inline-flex items-center rounded-full bg-blue-50 px-2 py-1 text-xs font-medium text-blue-700";
            tag.textContent = spec;
            specsTags.appendChild(tag);
          });

          specsWrapper.appendChild(specsTags);
          contentDiv.appendChild(specsWrapper);
        }

        flexWrapper.appendChild(contentDiv);

        const actionsDiv = document.createElement("div");
        actionsDiv.className = "ml-4 flex space-x-2";

        const editBtn = document.createElement("button");
        editBtn.className = "edit-department-btn rounded-md bg-blue-50 px-3 py-1 text-sm font-medium text-blue-700 hover:bg-blue-100";
        editBtn.textContent = "Edit";
        editBtn.addEventListener("click", () => editDepartment(department.id));
        actionsDiv.appendChild(editBtn);

        const deleteBtn = document.createElement("button");
        deleteBtn.className = "delete-department-btn rounded-md bg-red-50 px-3 py-1 text-sm font-medium text-red-700 hover:bg-red-100";
        deleteBtn.textContent = "Delete";
        deleteBtn.addEventListener("click", () => deleteDepartment(department.id));
        actionsDiv.appendChild(deleteBtn);

        flexWrapper.appendChild(actionsDiv);
        card.appendChild(flexWrapper);
        container.appendChild(card);
      });
    }

    function addButtonEventListeners() {
      // Edit buttons
      document.querySelectorAll(".edit-department-btn").forEach((btn) => {
        btn.addEventListener("click", (e) => {
          const id = e.target.getAttribute("data-department-id");
          editDepartment(id);
        });
      });

      // Delete buttons
      document.querySelectorAll(".delete-department-btn").forEach((btn) => {
        btn.addEventListener("click", (e) => {
          const id = e.target.getAttribute("data-department-id");
          deleteDepartment(id);
        });
      });
    }

    // Add department
    function addDepartment() {
      editingDepartment = null;
      document.getElementById("modal-title").textContent = "Add Department";
      document.getElementById("department-form").reset();
      document.getElementById("department-modal").classList.remove("hidden");
    }

    // Edit department
    function editDepartment(id) {
      const department = departments.find((d) => d.id === id);
      if (!department) {
        showNotification("Department not found", "error");
        return;
      }

      editingDepartment = department;
      document.getElementById("modal-title").textContent = "Edit Department";

      // Fill form
      document.getElementById("name").value = department.name;
      document.getElementById("hod").value = department.hod;
      document.getElementById("faculty").value = department.faculty;
      document.getElementById("labs").value = department.labs;
      document.getElementById("description").value =
        department.description || "";
      document.getElementById("specializations").value =
        department.specializations ? department.specializations.join("\n") : "";

      document.getElementById("department-modal").classList.remove("hidden");
    }

    // Delete department
    async function deleteDepartment(id) {
      if (!confirm("Are you sure you want to delete this department?")) return;

      try {
        const response = await fetch(`/api/admin/academics/departments/${id}`, {
          method: "DELETE",
        });

        if (response.ok) {
          departments = departments.filter((d) => d.id !== id);
          renderDepartments();
          showNotification("Department deleted successfully", "success");
        } else {
          const errorText = await response.text();
          throw new Error(errorText || "Failed to delete department");
        }
      } catch (error) {
        console.error("Error deleting department:", error);
        showNotification(
          "Error deleting department: " + error.message,
          "error"
        );
      }
    }

    // Save department
    async function saveDepartment(formData) {
      const departmentData = {
        name: formData.get("name"),
        hod: formData.get("hod"),
        faculty: parseInt(formData.get("faculty")),
        labs: parseInt(formData.get("labs")),
        description: formData.get("description") || null,
        specializations: formData.get("specializations")
          ? formData
              .get("specializations")
              .split("\n")
              .filter((line) => line.trim())
          : null,
      };

      try {
        const url = editingDepartment
          ? `/api/admin/academics/departments/${editingDepartment.id}`
          : "/api/admin/academics/departments";

        const method = editingDepartment ? "PUT" : "POST";

        const response = await fetch(url, {
          method,
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(departmentData),
        });

        if (response.ok) {
          document.getElementById("department-modal").classList.add("hidden");
          loadDepartments();
          showNotification(
            editingDepartment
              ? "Department updated successfully"
              : "Department created successfully",
            "success"
          );
        } else {
          const errorText = await response.text();
          throw new Error(errorText || "Failed to save department");
        }
      } catch (error) {
        console.error("Error saving department:", error);
        showNotification("Error saving department: " + error.message, "error");
      }
    }

    // Show notification
    function showNotification(message, type = "info") {
      const notification = document.createElement("div");
      notification.className = `fixed top-4 right-4 z-50 p-4 rounded-md shadow-lg ${
        type === "success"
          ? "bg-green-100 text-green-800 border border-green-200"
          : type === "error"
            ? "bg-red-100 text-red-800 border border-red-200"
            : "bg-blue-100 text-blue-800 border border-blue-200"
      }`;
      notification.textContent = message;

      document.body.appendChild(notification);

      setTimeout(() => {
        if (notification.parentNode) {
          notification.parentNode.removeChild(notification);
        }
      }, 3000);
    }

    document
      .getElementById("add-department-btn")
      .addEventListener("click", addDepartment);
    document.getElementById("close-modal").addEventListener("click", () => {
      document.getElementById("department-modal").classList.add("hidden");
    });
    document.getElementById("cancel-btn").addEventListener("click", () => {
      document.getElementById("department-modal").classList.add("hidden");
    });
    document
      .getElementById("department-form")
      .addEventListener("submit", (e) => {
        e.preventDefault();
        saveDepartment(new FormData(e.target));
      });

    document
      .getElementById("department-modal")
      .addEventListener("click", (e) => {
        if (e.target.id === "department-modal") {
          document.getElementById("department-modal").classList.add("hidden");
        }
      });

    loadDepartments();
  </script>
</AdminLayout>
